# Neon PostgreSQL (Vercel Storage / Neon dashboard)
# Pooled connection — runtime (Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection — migrations (prisma migrate deploy)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="admin@leventkoleji.com"
ADMIN_PASSWORD="change-me"

# Vercel Blob — kadro fotoğrafları (Storage → Blob → projeye bağlayın)
# Production'da BLOB_STORE_ID + OIDC otomatik gelir; yerelde vercel env pull kullanın.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""
